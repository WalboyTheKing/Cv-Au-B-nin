# ===================================================================
# CV PRO BÉNIN — VARIABLES D'ENVIRONNEMENT D'EXEMPLE (.env.example)
# ===================================================================

# Port d'écoute du serveur Node.js / Express
PORT=3000
NODE_ENV=development

# Clé API Google Gemini (serveur uniquement - ne jamais exposer au navigateur)
# Obtenez votre clé sur https://aistudio.google.com/
GEMINI_API_KEY=votre_cle_gemini_api_secrete

# Sel cryptographique pour le hachage des mots de passe locaux
AUTH_SALT=cle_secrete_aleatoire_hachage_mots_de_passe_2026

# Configuration Supabase (Production)
# Créez votre projet sur https://supabase.com
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_privee_serveur

# Coordonnées officielles Moov Money Bénin (Waaliyou Z Labouda)
MOOV_BENEFICIARY_NAME="Waaliyou Z Labouda"
MOOV_BENEFICIARY_PHONE="0194537741"
MOOV_USSD_CODE="*855#"
